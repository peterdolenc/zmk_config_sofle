#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>; };
&mmv {
    time-to-max-speed-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Lock {
            bindings = <&kp LG(LC(Q))>;
            key-positions = <0 11>;
        };

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <12 13 21>;
        };
        bt_next {
            bindings = <&bt BT_NXT>;
            key-positions = <12 13 23>;
        };
        bt_prev {
            bindings = <&bt BT_PRV>;
            key-positions = <12 13 22>;
        };

        slovenian {
            bindings = <&tog 1>;
            key-positions = <23 35>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 11>;
        };

        left_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <4 5>;
        };

        left_del {
            bindings = <&kp DELETE>;
            key-positions = <3 4>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <21 10>;
        };

        sleep {
            bindings = <&kp LS(LA(S))>;
            key-positions = <49 36>;
        };

        win-print-screen {
            bindings = <&kp LS(LC(X))>;
            key-positions = <11 23>;
        };

        email {
            bindings = <&email>;
            key-positions = <2 3 4>;
        };

        mac-print-screen {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <0 12>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        esc2 {
            bindings = <&kp ESCAPE>;
            key-positions = <6 7>;
        };

        esc3 {
            bindings = <&kp ESCAPE>;
            key-positions = <31 32 33>;
        };

        select-all {
            bindings = <&kp LC(A)>;
            key-positions = <31 32 33 34>;
        };

        caps-word {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };

      

        mouse {
            bindings = <&mo 3>;
            key-positions = <25 26 27 28>;
        };



        alt_tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <12 13>;
        };

        alt_tab2 {
            bindings = <&kp LA(TAB)>;
            key-positions = <28 27 26>;
        };

      

    };

    behaviors {
        ht_h: ht_h {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        ht_b: ht_b {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        sticky: sticky {
            compatible = "zmk,behavior-sticky-key";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        ht_bs_del: ht_bs_del {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&bs_del>;
            flavor = "balanced";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        bs_del: bs_del {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        qu_excl: qu_excl {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LS(MINUS)>, <&kp LS(N1)>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        htl_h: htl_h {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;
            flavor = "hold-preferred";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        htl_b: htl_b {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

       htl_t: htl_t {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

       scroll: scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <150>;     
        };

        mmvf:mmvf {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <200>;
            acceleration-exponent = <1>;
        };
    };

    macros {
        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E &kp M &kp A &kp I &kp L &kp RA(V) &kp P &kp E &kp T &kp E &kp R &kp D &kp O &kp L &kp E &kp N &kp C &kp DOT &kp S &kp I>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            bindings = <
&kp NUMBER_1    &kp N2       &kp N3      &kp N4        &kp N5        &kp N6                                                &kp N7         &kp N8           &kp N9            &kp N0         &kp MINUS        &kp EQUAL
&kp TAB         &kp Q        &kp W       &kp E         &kp R         &kp T                                                 &kp Y          &kp U            &kp I             &kp O          &kp P            &kp LEFT_BRACKET
&kp LSHIFT      &hm LCTRL A  &htl_t 4 S  &hm RALT D    &hm LALT F    &kp G                                                 &kp H          &hm LALT J       &hm RALT K        &htl_t 5 L     &qu_excl         &kp NON_US_HASH
&kp LCTRL       &hm LGUI Z   &kp X       &hm LSHIFT C  &hm LCTRL V   &kp B           &kp C_MUTE              &kp CAPSLOCK  &kp N          &kp M            &hm LSHIFT COMMA  &kp DOT        &kp SLASH        &kp LC(LS(M)) 
                             &kp LGUI    &kp LALT      &mo 3         &htl_h 2 ENTER  &ht_b LEFT_SHIFT SPACE  &bs_del       &mo 3          &kp ESC          &kp LC(A)         &kp INSERT         
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scroll MOVE_Y(50)  MOVE_Y(-50)>;
        };

        /* 1 */
        slo {
            display-name = "Slovenian";
            sensor-bindings = <&trans &trans>, <&trans &trans>;
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &kp SEMI  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans    &trans
                   &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };


        /* 2 */
        nums_fn_layer {
            display-name = "Nums/FN";
            sensor-bindings = <&trans &trans>, <&trans &trans>;
            bindings = <
&kp F1  &kp F2            &kp F3            &kp F4          &kp F5      &kp F6                          &kp F7      &kp F8        &kp F9         &kp F10        &kp F11            &kp F12
&kp LS(N1)  &kp LS(N2)    &kp LS(N3)        &kp LS(N4)      &kp LS(N5)  &kp LS(N6)                      &kp LS(N7)  &kp LS(N8)    &kp LS(N9)     &kp LS(N0)     &kp LS(MINUS)      &kp LS(EQUAL) 
&kp N1      &kp N2        &kp N3            &kp N4          &kp N5      &kp N6                          &kp N7      &kp N8        &kp N9         &kp N0         &kp MINUS          &kp EQUAL
&kp F1  &kp F2            &kp F3            &kp F4          &kp F5      &kp F6     &trans    &trans     &kp F7      &kp F8        &kp F9         &kp F10        &kp F11            &kp F12
                          &trans            &trans          &trans      &trans     &trans    &trans     &kp LA(TAB) &trans        &trans         &trans
            >;
        };


        /* 3 */
        navi {
            display-name = "navi";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &kp ESC        &trans      &trans      &trans        &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans         &kp HOME    &kp UP      &kp END       &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &kp BACKSPACE  &kp LEFT    &kp DOWN    &kp RIGHT     &kp DELETE  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans         &kp PG_UP   &trans      &kp PG_DN     &trans      &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans      &trans      &trans
            >;

            sensor-bindings =
                <&inc_dec_kp  RIGHT LEFT>,
                <&inc_dec_kp PG_UP  PG_DN>;
        };


        /* 4 */
        mouse {
            sensor-bindings = <&trans &trans>, <&trans &trans>;
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans                      &trans           &trans             &trans              &trans             &trans           &trans
&kp LA(TAB)  &trans   &trans  &trans  &trans  &trans                    &msc MOVE_Y(17)  &mkp LCLK           &mmv MOVE_UP        &mkp RCLK          &kp INSERT       &trans
&trans       &trans   &trans  &trans  &trans  &trans                    &msc MOVE_Y(-17) &mmv MOVE_LEFT      &mmv MOVE_DOWN      &mmv MOVE_RIGHT    &mkp RCLK        &trans
&trans       &trans   &trans  &trans  &trans  &trans  &trans  &trans    &trans           &msc MOVE_X(-17)    &trans              &msc MOVE_X(17)    &msc MOVE_Y(20)  &msc MOVE_X(20)
                      &trans  &trans  &trans  &trans  &trans  &mkp RCLK &mkp LCLK        &mkp MCLK           &msc MOVE_X(-20)    &msc MOVE_Y(-20)
            >;
        };


        /* 5 */
        numpad {
            display-name = "Numpad";
            sensor-bindings = <&trans &trans>, <&trans &trans>;
            bindings = <
&trans  &trans     &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp N0                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp MINUS                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL                  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* 6 */
        symbol {
            display-name = "Symbol";
            sensor-bindings = <&trans &trans>, <&trans &trans>;
            bindings = <
&trans  &trans     &trans  &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp N0                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS  &kp N4  &kp N5  &kp N6  &kp MINUS                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL                  &trans  &trans  &trans  &trans  &trans  &trans
                   &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
        
    };
};
